TIMETRACK_URL=https://www.metrobus.co.ca/api/timetrack/json/
TIMETRACK_CACHE_TTL_SECONDS=30

# Optional. A Google Cloud key with "Places API (New)" enabled and billing set up,
# restricted to this server (IP allowlist or no restriction, not HTTP referrer --
# referrer restrictions reject requests since a server-to-server call has none).
# Used by GET /geocode; the mobile app falls back to MapTiler if this is unset.
GOOGLE_MAPS_API_KEY=
